# ============================================
# ENVIRONMENT
# ============================================
# development | testing | production
ENVIRONMENT=development

# True | False
DEBUG=True

# ============================================
# DATABASE (PostgreSQL)
# ============================================
# Для локальной разработки: localhost
# Для Docker: db (имя сервиса в docker-compose.yml)
DATABASE_URL=postgresql://postgresql:postgresql@localhost:5432/habit_tracker

# Пул соединений
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ============================================
# JWT (аутентификация)
# ============================================
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-min-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# BOT (MAX Messenger)
# ============================================
# Получить в личном кабинете MAX
MAX_BOT_TOKEN=your-max-bot-token-here

# URL бэкенда для внутренних запросов
# Для Docker: http://backend:8000
# Для локальной разработки: http://localhost:8000
API_URL=http://backend:8000

# Публичный URL для вебхука (получить через ngrok/cloudflared/serveo.net)
# Пример: https://your-domain.com/webhook
WEBHOOK_URL=https://your-domain.com/webhook

# Порт для бота
BOT_PORT=8001

# Количество воркеров
BOT_WORKERS=4

# Путь к SQLite базе токенов (для бота)
TOKEN_DB_PATH=bot_tokens.db

# ============================================
# LOGGING
# ============================================
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Формат логов
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Файл для логов (опционально)
LOG_FILE=logs/app.log

# ============================================
# CORS (для фронтенда)
# ============================================
# Через запятую
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# ============================================
# SECURITY
# ============================================
# Разрешённые хосты (через запятую)
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================
# DOCKER (PostgreSQL) - используется в docker-compose.yml
# ============================================
POSTGRES_USER=postgresql
POSTGRES_PASSWORD=postgresql
POSTGRES_DB=habit_tracker

# ============================================
# REDIS (опционально, для кэширования)
# ============================================
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_EXPIRE=86400

# ============================================
# SENTRY (опционально, для мониторинга)
# ============================================
SENTRY_DSN=
